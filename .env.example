# Vercel 프로젝트 Settings > Environment Variables 에만 넣으세요. 저장소에 커밋하지 않습니다.
ANTHROPIC_API_KEY=

# 선택 (넣지 않으면 기본값)
# AI_MODEL=claude-opus-5-5        # claude-sonnet-5-5 / claude-haiku-5-5 로 바꿔 비용 비교
# AI_EFFORT=medium                # low / medium / high (단계별: AI_EFFORT_OUTLINE, AI_EFFORT_TEXT, AI_EFFORT_MOTION)
# DAILY_LIMIT=150                 # IP당 하루 AI 호출 수 (카드 1장 = 1회)
# AI_CARD_BUDGET_MS=170000        # 텍스트 숏츠 카드 한 장에 쓰는 최대 시간 (재시도 포함)
# AI_SCENE_BUDGET_MS=170000       # 모션그래픽 카드 한 장에 쓰는 최대 시간 (재시도 포함)
# AI_DEADLINE_MS=200000           # 개념 뽑기에 쓰는 최대 시간

# 키 없이 화면 흐름만 시험할 때 (로컬 전용)
# MOCK_AI=1
